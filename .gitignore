# Data folder: ignore all CSVs, but keep .gitkeep
data/*.csv
data/**/*.csv
!data/.gitkeep

# Deliverables folder: ignore contents except .gitkeep
deliverables/*
!deliverables/
!deliverables/.gitkeep

# Ignore generated SQLite database
olist.db
*.sqlite
*.sqlite3
*.db

# Root feature backup
training_features.csv

# ==============================================================================
# Python & Environment Artifacts
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Conda (fallback ignore)
.conda/
conda-bld/
myenv/

# Serialized models & checkpoints
*.pkl
*.pickle
*.joblib
.ipynb_checkpoints/

# ==============================================================================
# OS & IDE Files
# ==============================================================================
.DS_Store
Thumbs.db
[Dd]esktop.ini
.vscode/
.idea/
.env