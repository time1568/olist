# ==============================================================================
# Deliverables Folder
# ==============================================================================
# Ignore all generated deliverables, but keep folder tracked
deliverables/*
!deliverables/.gitkeep

# ==============================================================================
# Data & Database Files
# ==============================================================================
# Ignore all CSV files anywhere in data/
data/*.csv
data/**/*.csv

# Keep data folder structure tracked
!data/.gitkeep

# Ignore generated SQLite database
olist.db
*.sqlite
*.sqlite3
*.db

# Root feature backup
training_features.csv

# ==============================================================================
# Python & Environment Artifacts
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Conda (fallback ignore)
.conda/
conda-bld/
myenv/

# Serialized models & checkpoints
*.pkl
*.pickle
*.joblib
.ipynb_checkpoints/

# ==============================================================================
# OS & IDE Files
# ==============================================================================
.DS_Store
Thumbs.db
[Dd]esktop.ini
.vscode/
.idea/
.env